# Response headers for static assets, parsed natively by Cloudflare Workers.
# This replaces next.config.mjs's headers(), which does nothing under
# `output: 'export'`. Rules here apply to asset responses only.
#
# The previous config also carried a /static/* cache rule; there is no
# public/static directory, so it never matched anything and is not carried over.

/*
  X-DNS-Prefetch-Control: on
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# script-src carries 'unsafe-inline' because this is a static export: Next
# inlines its own bootstrap and the theme script has to run before first paint,
# and with no server there is no nonce to hand them. The rest of the policy
# still does the work — connect-src keeps the page from talking to any other
# origin (icons come from the build, not a runtime API), fonts are self-hosted
# by next/font, and object-src/base-uri/frame-ancestors close the usual
# redirect and injection routes.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
